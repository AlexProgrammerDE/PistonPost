{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "entry": [
    "auth-schema.config.ts",
    "scripts/**/*.ts",
    "tests/e2e/**/*.ts",
    "src/lib/auth/auth-plugin.ts",
    "src/routes/**/*.{ts,tsx}",
    "src/styles/**/*.css",
    "cloudflare.config.ts"
  ],
  "project": ["*.ts", "scripts/**/*.ts", "tests/**/*.ts", "src/**/*.{ts,tsx}"],
  "ignore": ["src/components/auth/**", "src/components/ui/**", "src/lib/auth/**"],
  "ignoreDependencies": [
    "@tanstack/react-devtools",
    "@tanstack/react-router-devtools",
    "@tanstack/router-plugin",
    "cloudflare",
    "embla-carousel-react",
    "fscreen",
    "wasm-pack"
  ]
}

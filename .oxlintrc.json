{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "react-perf",
    "jsx-a11y",
    "vitest",
    "effecttsgo",
    "promise"
  ],
  "jsPlugins": [
    "@shadcn/lint",
    "eslint-plugin-better-tailwindcss",
    { "name": "tanstack-router", "specifier": "@tanstack/eslint-plugin-router" },
    { "name": "tanstack-query", "specifier": "@tanstack/eslint-plugin-query" },
    { "name": "drizzle", "specifier": "eslint-plugin-drizzle" },
    { "name": "react-hooks-js", "specifier": "eslint-plugin-react-hooks" }
  ],
  "settings": {
    "better-tailwindcss": {
      "entryPoint": "src/styles/globals.css"
    }
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "rules": {
    "tanstack-router/create-route-property-order": "error",
    "tanstack-router/route-param-names": "error",
    "tanstack-query/exhaustive-deps": "error",
    "tanstack-query/stable-query-client": "error",
    "tanstack-query/no-rest-destructuring": "error",
    "tanstack-query/no-unstable-deps": "error",
    "tanstack-query/infinite-query-property-order": "error",
    "tanstack-query/mutation-property-order": "error",
    "drizzle/enforce-delete-with-where": [
      "error",
      { "drizzleObjectName": ["db", "database", "tx", "transaction"] }
    ],
    "drizzle/enforce-update-with-where": [
      "error",
      { "drizzleObjectName": ["db", "database", "tx", "transaction"] }
    ],
    "react-hooks-js/component-hook-factories": "error",
    "react-hooks-js/static-components": "error",
    "react-hooks-js/use-memo": "error",
    "react-hooks-js/preserve-manual-memoization": "error",
    "react-hooks-js/incompatible-library": "error",
    "react-hooks-js/immutability": "error",
    "react-hooks-js/globals": "error",
    "react-hooks-js/refs": "error",
    "react-hooks-js/set-state-in-effect": "error",
    "react-hooks-js/error-boundaries": "error",
    "react-hooks-js/purity": "error",
    "react-hooks-js/set-state-in-render": "error",
    "react-hooks-js/unsupported-syntax": "error",
    "react-hooks-js/config": "error",
    "react-hooks-js/gating": "error",
    // The style preset also suggests explicit conditions and pipeable signatures.
    // Those rules report 2,907 and 169 findings in the full probe.
    "effecttsgo/deterministic-keys": "error",
    "effecttsgo/effect-do-notation": "error",
    "effecttsgo/effect-try-without-catch": "error",
    "effecttsgo/for-loop-push-to-for-each": "error",
    "effecttsgo/map-map-error-to-map-both": "error",
    "effecttsgo/missed-pipeable-opportunity": "error",
    "effecttsgo/missing-concurrency-option": "error",
    "effecttsgo/missing-effect-service-dependency": "error",
    "effecttsgo/nested-effect-gen-yield": "error",
    "effecttsgo/new-schema-class": "error",
    "effecttsgo/prefer-barrel-import": "error",
    "effecttsgo/prefer-namespace-import": "error",
    "effecttsgo/prefer-schema-type-property": "error",
    "effecttsgo/provide-merge-all-to-array": "error",
    "effecttsgo/schema-union-of-literals": "error",
    "effecttsgo/service-not-as-class": "error",
    "effecttsgo/type-union-to-schema-union": "error",
    "effecttsgo/unnecessary-arrow-block": "error",

    "effecttsgo/global-date-in-effect": "error",
    "effecttsgo/global-json-in-effect": "error",
    "effecttsgo/process-env-in-effect": "error",
    "effecttsgo/crypto-random-uuid-in-effect": "error",
    "effecttsgo/global-console-in-effect": "error",
    "effecttsgo/global-random-in-effect": "error",
    "effecttsgo/global-fetch-in-effect": "error",
    "effecttsgo/global-timers-in-effect": "error",
    "effecttsgo/prefer-schema-over-json": "error",
    "effecttsgo/prefer-schema-tagged-error": "error",
    "effecttsgo/extends-native-error": "error",
    "effecttsgo/yield-in-call-argument": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-import-type-side-effects": "error",
    "unicorn/error-message": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/no-document-cookie": "error",
    "unicorn/numeric-separators-style": "error",
    "unicorn/prefer-string-raw": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/prefer-response-static-json": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/text-encoding-identifier-case": "error",
    "eslint/no-param-reassign": "error",
    "eslint/no-shadow": "error",
    "eslint/prefer-const": "error",
    "eslint/prefer-object-has-own": "error",
    "eslint/no-alert": "error",
    "eslint/no-script-url": "error",
    "eslint/object-shorthand": "error",
    "eslint/prefer-template": "error",
    "eslint/logical-assignment-operators": "error",
    "oxc/no-map-spread": "error",
    "oxc/no-barrel-file": "error",
    "react/self-closing-comp": "error",
    "react/jsx-boolean-value": "error",
    "react/jsx-curly-brace-presence": "error",
    "react/jsx-fragments": "error",
    "react/hook-use-state": "error",
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": ["vds-poster"]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": ["layout"]
      }
    ],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^Alert$",
            "allow": [
              "layout",
              "border-l-4",
              "border-l-callout-tip",
              "border-l-callout-warning",
              "border-l-primary",
              "py-2",
              "rounded-md"
            ]
          },
          {
            "pattern": "^AlertDescription$",
            "allow": ["layout", "gap-3", "gap-4", "text-xs", "truncate"]
          },
          {
            "pattern": "^AspectRatio$",
            "allow": ["layout", "bg-black", "bg-muted", "not-typeset"]
          },
          {
            "pattern": "^AvatarFallback$",
            "allow": ["layout", "font-heading", "text-2xl", "text-foreground"]
          },
          {
            "pattern": "^Button$",
            "allow": [
              "layout",
              "hover:text-foreground",
              "px-1",
              "rounded-md",
              "sm:px-3",
              "text-muted-foreground",
              "yarl__button"
            ]
          },
          {
            "pattern": "^ButtonGroup$",
            "allow": ["layout", "border-t", "pt-2"]
          },
          {
            "pattern": "^ButtonGroupText$",
            "allow": ["layout", "tabular-nums"]
          },
          {
            "pattern": "^CredenzaBody$",
            "allow": ["layout", "gap-4"]
          },
          {
            "pattern": "^Empty$",
            "allow": ["layout", "border", "border-y", "p-6", "rounded-none"]
          },
          {
            "pattern": "^Field$",
            "allow": ["layout", "gap-2"]
          },
          {
            "pattern": "^FieldGroup$",
            "allow": ["layout", "gap-3", "gap-5", "gap-6"]
          },
          {
            "pattern": "^FieldLabel$",
            "allow": ["layout", "font-normal"]
          },
          {
            "pattern": "^FieldLegend$",
            "allow": ["layout", "gap-2"]
          },
          {
            "pattern": "^FileUploadDropzone$",
            "allow": [
              "layout",
              "data-dragging:bg-primary/5",
              "data-dragging:border-primary",
              "data-dragging:ring-3",
              "data-dragging:ring-primary/15"
            ]
          },
          {
            "pattern": "^InputGroupAddon$",
            "allow": ["layout", "border-b", "border-t"]
          },
          {
            "pattern": "^InputGroupText$",
            "allow": ["layout", "tabular-nums", "text-xs"]
          },
          {
            "pattern": "^Item$",
            "allow": [
              "layout",
              "bg-background",
              "bg-muted/25",
              "border-t-0",
              "border-x-0",
              "last:border-b-0",
              "no-underline",
              "not-typeset",
              "p-3",
              "px-0",
              "px-1",
              "py-5",
              "rounded-none",
              "sm:px-3"
            ]
          },
          {
            "pattern": "^ItemActions$",
            "allow": ["layout", "tabular-nums", "text-muted-foreground", "text-sm"]
          },
          {
            "pattern": "^ItemContent$",
            "allow": ["layout", "gap-2"]
          },
          {
            "pattern": "^ItemDescription$",
            "allow": ["layout", "line-clamp-none", "text-xs", "truncate"]
          },
          {
            "pattern": "^ItemGroup$",
            "allow": ["layout", "border-y", "gap-0"]
          },
          {
            "pattern": "^ItemMedia$",
            "allow": ["layout", "bg-muted", "rounded-none"]
          },
          {
            "pattern": "^ItemTitle$",
            "allow": ["layout", "line-clamp-2", "line-clamp-none"]
          },
          {
            "pattern": "^Progress$",
            "allow": ["layout", "gap-1"]
          },
          {
            "pattern": "^SidebarFooter$",
            "allow": ["layout", "gap-0", "p-0"]
          },
          {
            "pattern": "^SidebarHeader$",
            "allow": ["layout", "group-data-[collapsible=icon]:p-2", "px-4", "py-3"]
          },
          {
            "pattern": "^Skeleton$",
            "allow": ["layout", "rounded-full"]
          },
          {
            "pattern": "^TableCell$",
            "allow": ["layout", "text-muted-foreground", "text-xs"]
          },
          {
            "pattern": "^TableHead$",
            "allow": ["layout", "py-4"]
          },
          {
            "pattern": "^TableRow$",
            "allow": ["layout", "hover:bg-transparent"]
          },
          {
            "pattern": "^Tabs$",
            "allow": ["layout", "gap-3"]
          },
          {
            "pattern": "^TabsContent$",
            "allow": ["layout", "bg-background", "border", "p-4"]
          },
          {
            "pattern": "^Timeline$",
            "allow": ["layout", "gap-0"]
          },
          {
            "pattern": "^TimelineItem$",
            "allow": ["layout", "gap-3", "pb-10", "sm:gap-4"]
          },
          {
            "pattern": "^TooltipTrigger$",
            "allow": [
              "layout",
              "focus-visible:outline-2",
              "focus-visible:outline-offset-4",
              "focus-visible:outline-ring",
              "outline-none",
              "text-sidebar-foreground"
            ]
          },
          {
            "pattern": "^Toggle$",
            "allow": [
              "layout",
              "aria-pressed:bg-primary/10",
              "aria-pressed:text-primary",
              "dark:aria-pressed:bg-primary/15",
              "hover:text-foreground",
              "px-1",
              "rounded-md",
              "sm:px-3",
              "text-muted-foreground"
            ]
          }
        ]
      }
    ],
    "shadcn/require-static-classes": "error",
    "shadcn/no-inline-styles": "error",
    "react/no-array-index-key": "error",
    "react/react-in-jsx-scope": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/no-unstable-nested-components": [
      "error",
      {
        "allowAsProps": true
      }
    ],
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "kebabCase": true,
          "pascalCase": true
        }
      }
    ],
    "effecttsgo/any-unknown-in-error-context": "off",
    "effecttsgo/unsafe-effect-type-assertion": "off",
    "effecttsgo/strict-effect-provide": "off",
    "typescript/restrict-plus-operands": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/return-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-optional-chain": "error",
    // TanStack Router control flow throws redirect() and notFound() results.
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "@tanstack/router-core",
            "name": ["Redirect", "NotFoundError"]
          }
        ]
      }
    ],
    "typescript/no-deprecated": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-explicit-any": "error",
    "eslint/array-callback-return": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-fallthrough": "error",
    "eslint/no-loop-func": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-console": "error",
    "eslint/no-await-in-loop": "off",
    "unicorn/no-abusive-eslint-disable": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/prefer-ts-expect-error": "error",
    "better-tailwindcss/no-conflicting-classes": "error",
    "better-tailwindcss/no-duplicate-classes": "error",
    "better-tailwindcss/no-deprecated-classes": "error",
    "better-tailwindcss/enforce-canonical-classes": "error",
    "import/no-duplicates": "error",
    "import/no-cycle": ["error", { "ignoreTypes": true }],
    "promise/catch-or-return": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-top-level-await": "error",
    "react/jsx-no-constructed-context-values": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/no-object-type-as-default-prop": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
    "eslint/no-useless-call": "error",
    "oxc/no-accumulating-spread": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-readonly": "error",
    "typescript/no-useless-empty-export": "error",
    // Allow `while (true)` loops that read streams until they end.
    "typescript/no-unnecessary-condition": [
      "error",
      { "allowConstantLoopConditions": "only-allowed-literals" }
    ],
    // `||` is intended where an empty string falls back to a default, and where `false`
    // must become `undefined` so React omits a data attribute.
    "typescript/prefer-nullish-coalescing": [
      "error",
      { "ignorePrimitives": { "string": true, "boolean": true } }
    ],
    "typescript/require-await": "error",
    "typescript/no-non-null-assertion": "error",
    "react/jsx-no-target-blank": "error",
    "react/button-has-type": "error",
    "react/no-danger": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/no-unknown-property": "error",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ],
    // Pedantic rules that only measure size or encode a style preference.
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-depth": "off",
    "eslint/max-nested-callbacks": "off",
    "eslint/max-classes-per-file": "off",
    "import/max-dependencies": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-warning-comments": "off",
    "eslint/no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    // Duplicates typescript/require-await, which knows about type information.
    "eslint/require-await": "off",
    // Conflicts with the prefer-nullish-coalescing ignorePrimitives setup above.
    "typescript/strict-boolean-expressions": "off",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/array-type": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/prefer-function-type": "error",
    "typescript/consistent-indexed-object-style": "error",
    "unicorn/switch-case-braces": "error",
    "eslint/no-useless-assignment": "error",
    // consistent-return requires explicit undefined in functions with multiple return paths.
    "unicorn/no-useless-undefined": "off",
    "typescript/consistent-return": "error",
    // The Cloudflare HTMLRewriter Element type merges into the DOM Element type, so
    // Element.append only accepts strings, streams and responses in this project.
    "unicorn/prefer-dom-node-append": "off",
    // TypeScript reports real redeclarations. This rule flags Effect Schema values that
    // share a name with their type, such as `PushDeliveryJob`.
    "eslint/no-redeclare": "off"
  },
  "overrides": [
    {
      "files": ["tests/e2e/**/*.ts"],
      "jsPlugins": [{ "name": "playwright", "specifier": "eslint-plugin-playwright" }],
      "rules": {
        "playwright/missing-playwright-await": "error",
        "playwright/no-focused-test": "error",
        "playwright/no-skipped-test": "error",
        "playwright/no-wait-for-timeout": "error",
        "playwright/no-wait-for-selector": "error",
        "playwright/prefer-web-first-assertions": "error",
        "playwright/no-force-option": "error",
        "playwright/no-networkidle": "error",
        "playwright/no-page-pause": "error",
        "playwright/no-useless-await": "error",
        "playwright/valid-expect": "error"
      }
    },
    {
      "files": [
        "src/server.ts",
        "src/server/**",
        "src/db/**",
        "src/auth/*.server.ts",
        "src/auth/server.ts",
        "src/lib/**/*.server.ts",
        "src/lib/server-uuid.ts",
        "src/routes/**/*.ts",
        "src/email/*.ts",
        "src/push/**",
        "scripts/**/*.ts"
      ],
      "rules": {
        "effecttsgo/global-date": "error",
        "effecttsgo/global-json": "error",
        "effecttsgo/global-fetch": "error",
        "effecttsgo/global-timers": "error",
        "effecttsgo/global-random": "error",
        "effecttsgo/crypto-random-uuid": "error",
        "effecttsgo/process-env": "error",
        "effecttsgo/global-console": "error",
        "effecttsgo/node-builtin-import": "error"
      }
    },
    {
      // Tests use native fixture APIs and exercise the platform boundaries directly.
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "effecttsgo/global-date": "off",
        "effecttsgo/global-json": "off",
        "effecttsgo/global-fetch": "off",
        "effecttsgo/global-timers": "off",
        "effecttsgo/global-random": "off",
        "effecttsgo/crypto-random-uuid": "off",
        "effecttsgo/process-env": "off",
        "effecttsgo/global-console": "off",
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      // The CLI entry points preserve their output and use native build and network tooling.
      "files": [
        "scripts/check-client-bundles.ts",
        "scripts/check-generated.ts",
        "scripts/load-test.ts",
        "scripts/smoke-production.ts"
      ],
      "rules": {
        "effecttsgo/global-date": "off",
        "effecttsgo/global-json": "off",
        "effecttsgo/global-fetch": "off",
        "effecttsgo/global-timers": "off",
        "effecttsgo/global-random": "off",
        "effecttsgo/crypto-random-uuid": "off",
        "effecttsgo/process-env": "off",
        "effecttsgo/global-console": "off",
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      // Date values are constructed at synchronous query, statement, and framework boundaries.
      "files": [
        "src/db/account-ban.ts",
        "src/db/factories.ts",
        "src/db/post-edit-statements.ts",
        "src/db/public-read-model.ts",
        "src/db/push-subscription-queries.ts",
        "src/push/transport.ts",
        "src/server/image-upload-statements.ts",
        "src/server/media-access.ts",
        "src/server/post-lifecycle-statements.ts",
        "src/server/request-session.ts",
        "src/server/tables.ts"
      ],
      "rules": {
        "effecttsgo/global-date": "off"
      }
    },
    {
      // These synchronous SQL and cursor builders serialize the values bound to the existing storage format.
      "files": [
        "src/db/media-read-model.ts",
        "src/db/post-edit-statements.ts",
        "src/server/image-upload-statements.ts",
        "src/server/post-lifecycle-statements.ts",
        "src/server/tables.ts"
      ],
      "rules": {
        "effecttsgo/global-json": "off"
      }
    },
    {
      // These synchronous helpers supply IDs to framework error and job payloads.
      "files": ["src/server/jobs.ts", "src/server/server-function-failure.ts"],
      "rules": {
        "effecttsgo/crypto-random-uuid": "off"
      }
    },
    {
      // Workers Logs consumes a single structured console line from synchronous callers.
      "files": ["src/server/error-log.ts"],
      "rules": {
        "effecttsgo/global-console": "off",
        "effecttsgo/global-json": "off"
      }
    },
    {
      // Native streaming routes hand Fetch responses directly to the Worker framework.
      "files": ["src/routes/media.external-image.$postId.ts"],
      "rules": {
        "effecttsgo/global-fetch": "off"
      }
    },
    {
      // The upload route owns the request timing and staging identifiers at the streaming boundary.
      "files": ["src/routes/media.upload.$mediaId.ts"],
      "rules": {
        "effecttsgo/global-date": "off",
        "effecttsgo/crypto-random-uuid": "off"
      }
    },
    {
      // Vite targets Safari 16.4. Response.json() is available starting in Safari 17.
      "files": [
        "public/**/*.js",
        "src/auth/client.ts",
        "src/client.tsx",
        "src/components/**",
        "src/hooks/**",
        "src/lib/**",
        "src/router.tsx",
        "src/routes/**/*.tsx",
        "src/start.ts"
      ],

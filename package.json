{
  "name": "pistonpost",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cf build",
    "bundle:check": "bun scripts/check-client-bundles.ts",
    "cf:typegen": "cf workers types",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "ci": "bun run check && bun run knip && bun run build && bun run bundle:check && bun run cf:dry-run",
    "deploy:dry-run": "bun run build && cf deploy --prebuilt --mode production --dry-run",
    "dev": "cf dev",
    "dev:web": "bun run dev",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "fix": "oxfmt . && oxlint --type-aware --fix --fix-suggestions .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generated:check": "bun scripts/check-generated.ts",
    "knip": "knip",
    "lint": "bun run cf:typegen && oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "load:test": "bun scripts/load-test.ts",
    "prepare": "./scripts/prepare-effect.sh && lefthook install && effect-tsgo patch --no-typescript --oxlint",
    "preview": "cf dev --mode production",
    "smoke:production": "bun scripts/smoke-production.ts",
    "test": "bun test --path-ignore-patterns='tests/e2e/**'",
    "test:e2e": "playwright test",
    "test:prepare-db": "wrangler d1 migrations apply DB --config tests/fixtures/wrangler.local.jsonc --local --persist-to .wrangler/state",
    "test:web": "bun test --path-ignore-patterns='tests/e2e/**'",
    "typecheck": "bun run cf:typegen && tsgo --noEmit",
    "typecheck:web": "bun run typecheck",
    "wasm:build": "bun scripts/build-image-sanitizer.ts",
    "cf:dry-run": "bun run deploy:dry-run",
    "build:production": "vite build --mode prod"
  },

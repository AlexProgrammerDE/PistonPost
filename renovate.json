{
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "reviewers": ["AlexProgrammerDE"],
  "packageRules": [
    {
      "description": "Keep dash.js aligned with the Vidstack DASH provider",
      "matchPackageNames": ["dashjs"],
      "allowedVersions": "4.7.4"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "TanStack Table v9 is beta. Review every update deliberately.",
      "matchPackageNames": ["@tanstack/react-table"],
      "groupName": "TanStack Table",
      "automerge": false
    }
  ]
}

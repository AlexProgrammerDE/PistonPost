{
  "id": "/",
  "short_name": "PistonPost",
  "name": "PistonPost",
  "description": "Posts, pictures, videos, and whatever else is worth passing around.",
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#fff9ed",
  "background_color": "#fff9ed",
  "categories": ["social", "entertainment"],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/gif",
            "image/webp",
            "image/avif",
            ".jpg",
            ".jpeg",
            ".png",
            ".gif",
            ".webp",
            ".avif"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/posts/new",
      "accept": {
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "image/gif": [".gif"],
        "image/webp": [".webp"],
        "image/avif": [".avif"]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "New post",
      "short_name": "New post",
      "description": "Make a new post.",
      "url": "/posts/new",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/composer-desktop.png",
      "sizes": "1366x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Write a post and save a text draft on this device."
    },
    {
      "src": "/screenshots/composer-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Write posts and choose pictures or video on your phone."
    }
  ]
}
